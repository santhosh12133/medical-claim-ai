# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.

POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Public frontend origin used by the API CORS policy.
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000

# Production controls
ENVIRONMENT=production
MAX_UPLOAD_SIZE_MB=10
RAG_ENABLED=true
# Vector store: sql (default, embeddings in PostgreSQL) | chroma (optional, pip install chromadb)
RAG_VECTOR_BACKEND=sql
RAG_MIN_SIMILARITY=0.30
RAG_MIN_CONFIDENCE=0.55
RAG_CHUNK_SIZE=180
RAG_CHUNK_OVERLAP=30
RAG_HYBRID_ENABLED=true
# heuristic (default, no model) | cross-encoder (better ranking, downloads a model) | none
RAG_RERANKER=heuristic
# partial: approve up to the cap | reject: legacy behaviour (reject any over-limit claim)
RAG_OVER_LIMIT_POLICY=partial

# Keep these disabled until the deployment has been validated.
# LLM features are optional. Provider: openai | anthropic
LLM_PROVIDER=openai
GPT_DECISION_ENABLED=false
LLM_QA_ENABLED=false
LLM_REDACT_PII=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AUTO_DECISION_ENABLED=false
AUTO_DECISION_MIN_CONFIDENCE=0.85
AUTO_DECISION_REQUIRE_GPT=false
AUTO_DECISION_MAX_AMOUNT=
