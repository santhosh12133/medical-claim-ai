# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.

POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Public frontend origin used by the API CORS policy.
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000

# Production controls
ENVIRONMENT=production
MAX_UPLOAD_SIZE_MB=10
RAG_ENABLED=true
RAG_MIN_SIMILARITY=0.45
RAG_MIN_CONFIDENCE=0.55

# Keep these disabled until the deployment has been validated.
GPT_DECISION_ENABLED=false
OPENAI_API_KEY=
AUTO_DECISION_ENABLED=false
AUTO_DECISION_MIN_CONFIDENCE=0.85
AUTO_DECISION_REQUIRE_GPT=false
AUTO_DECISION_MAX_AMOUNT=
