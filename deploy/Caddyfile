# One public address for the whole app: the website at /, the API at /api/.
# SITE_ADDRESS is a domain name (automatic HTTPS from Let's Encrypt) or ":80" (plain HTTP, no domain).
{$SITE_ADDRESS} {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Other apps on this server add their own site blocks as *.caddy files in the folder mounted at
# /etc/caddy/sites (host: /opt/caddy-sites). No files is fine. Each app's setup script writes its file and
# reloads Caddy; this file and Medical Claim AI's own site above stay unchanged.
import /etc/caddy/sites/*.caddy
