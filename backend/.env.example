# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medical_claims
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Application
ENVIRONMENT=development
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
SECRET_KEY=replace-with-a-32-plus-character-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG
RAG_ENABLED=true
RAG_UPLOAD_DIR=policy_uploads
RAG_CHROMA_PATH=chroma
RAG_COLLECTION_NAME=policy_chunks
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.45
RAG_MIN_CONFIDENCE=0.55
RAG_MAX_UPLOAD_SIZE_MB=20
RAG_LOG_LEVEL=INFO
RAG_LOG_DIR=logs

# GPT-assisted claim adjudication
# Keep disabled until OPENAI_API_KEY is configured securely in the deployment environment.
GPT_DECISION_ENABLED=false
GPT_DECISION_MODEL=gpt-5.6-luna
GPT_DECISION_TIMEOUT_SECONDS=20
OPENAI_API_KEY=replace-with-your-openai-api-key
