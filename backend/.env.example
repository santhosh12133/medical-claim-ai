# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medical_claims
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Application
ENVIRONMENT=development
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
SECRET_KEY=replace-with-a-32-plus-character-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG
RAG_ENABLED=true
RAG_UPLOAD_DIR=policy_uploads
# Only used when RAG_VECTOR_BACKEND=chroma
RAG_CHROMA_PATH=chroma
RAG_COLLECTION_NAME=policy_chunks
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector store: sql (default, embeddings in the database) | chroma (optional, pip install chromadb)
RAG_VECTOR_BACKEND=sql
# Chunk sizes are in words; 180 fits the 256-token window of MiniLM-class embedders.
RAG_CHUNK_SIZE=180
RAG_CHUNK_OVERLAP=30
RAG_CONTEXTUAL_HEADERS=true
RAG_PDF_OCR_FALLBACK=true
RAG_TOP_K=5
RAG_CANDIDATE_POOL=20
RAG_HYBRID_ENABLED=true
RAG_VECTOR_WEIGHT=1.0
RAG_LEXICAL_WEIGHT=1.0
RAG_RRF_K=60
# heuristic | cross-encoder | none
RAG_RERANKER=heuristic
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_LEXICAL_INDEX_TTL=30
RAG_QUERY_CACHE_SIZE=512
RAG_MIN_SIMILARITY=0.30
RAG_MIN_CONFIDENCE=0.55
RAG_MAX_UPLOAD_SIZE_MB=20
RAG_LOG_LEVEL=INFO
RAG_LOG_DIR=logs
# Optional JSON file extending the treatment taxonomy: {"Dental": ["aligners", ...]}
# RAG_TAXONOMY_PATH=taxonomy.json

# Adjudication
# partial: approve up to the cap | reject: legacy behaviour
RAG_OVER_LIMIT_POLICY=partial
RAG_USE_ANNUAL_UTILIZATION=true

# LLM features (optional). Provider: openai | anthropic
# Keep disabled until the API key is configured securely in the deployment environment.
LLM_PROVIDER=openai
GPT_DECISION_ENABLED=false
LLM_QA_ENABLED=false
LLM_REDACT_PII=true
LLM_MAX_OUTPUT_TOKENS=800
GPT_DECISION_MODEL=gpt-5.6-luna
GPT_DECISION_TIMEOUT_SECONDS=20
OPENAI_API_KEY=replace-with-your-openai-api-key
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Autonomous decision engine
# Keep disabled during validation. Enable only after benchmark results are reviewed.
AUTO_DECISION_ENABLED=false
AUTO_DECISION_MIN_CONFIDENCE=0.85
AUTO_DECISION_REQUIRE_GPT=false
# Optional safety ceiling. Leave empty for no additional amount ceiling.
AUTO_DECISION_MAX_AMOUNT=

# Async claim worker
# Run one or more worker processes separately from the FastAPI web process.
CLAIM_WORKER_BATCH_SIZE=8
CLAIM_WORKER_CONCURRENCY=4
CLAIM_WORKER_POLL_SECONDS=2
CLAIM_WORKER_MAX_ATTEMPTS=3
CLAIM_WORKER_LEASE_MINUTES=15
CLAIM_AUTO_VERIFY=true

# Login protection
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
